# Direct API access. Callers send their own API key (Authorization: Bearer),
# or none, in which case tr-engine's anonymous access policy applies.
tr-engine.luxprimatech.com {
	reverse_proxy tr-engine:8080
}

# Dashboard frontend + API proxy.
# The dashboard calls /api/v1 on its own origin, so /api/* goes to tr-engine
# unchanged. Never add an Authorization header here: a key injected into
# visitors' requests is a key every visitor has. Public read access is set
# with the anonymous access policy instead (tr-engine access set; docs/auth.md).
tr-dashboard.luxprimatech.com {
	handle /api/* {
		reverse_proxy tr-engine:8080
	}

	handle {
		reverse_proxy tr-dashboard:3000
	}
}
